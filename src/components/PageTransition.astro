---

<div
  id="page-transition"
  class="fixed inset-0 z-[97] pointer-events-none"
  aria-hidden="true"
  style="contain: strict;"
>
  <!-- Layer 1: blue drum halo wipe -->
  <div
    id="pt-halo"
    class="absolute inset-0 bg-ink-2"
    style="clip-path: circle(0px at 50vw 50vh); transform: translateZ(0); backface-visibility: hidden;"
  >
  </div>

  <!-- Layer 2: pink drum leading wave wipe -->
  <div
    id="pt-accent"
    class="absolute inset-0 bg-accent"
    style="clip-path: circle(0px at 50vw 50vh); transform: translateZ(0); backface-visibility: hidden;"
  >
  </div>

  <!-- Layer 3: blue canvas fill wipe -->
  <div
    id="pt-wipe"
    class="absolute inset-0 flex flex-col items-center justify-center bg-ink overflow-hidden"
    style="clip-path: circle(0px at 50vw 50vh); transform: translateZ(0); backface-visibility: hidden;"
  >
    <div
      id="pt-content"
      class="flex flex-col items-center justify-center px-4 text-center transform-gpu"
    >
      <p
        id="pt-kicker"
        class="text-sm font-medium text-paper mb-3 opacity-0 select-none whitespace-nowrap sm:mb-4"
      >
        Indian coal, clay ovens
      </p>
      <p
        id="pt-brand"
        class="split font-display text-paper text-[min(18vw,165px)] leading-none select-none opacity-0"
      >
        Bonfire
      </p>
    </div>
  </div>
</div>
