---
import Button from './Button.astro';
import { Image } from 'astro:assets';
import { heroTandoor } from '../assets/images';
---

<section
  id="hero"
  class="hero-section relative flex w-full flex-col overflow-hidden bg-paper"
  style="min-height: 100dvh"
>
  <!-- Full-bleed duotone plate: the user's own tandoor photograph, both drums -->
  <figure
    class="hero-plate grain absolute inset-0"
    data-slot="hero"
    data-alt="A smoking tandoor kebab platter on a dark wooden table, seen by candlelight"
  >
    <Image
      src={heroTandoor}
      alt="A smoking tandoor kebab platter on a dark wooden table, seen by candlelight"
      class="w-full object-cover select-none"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      widths={[960, 1280, 1600, 1920]}
      sizes="100vw"
      format="webp"
      quality={82}
    />
  </figure>

  <!-- Ink scrim behind the head, this side only -->
  <div class="hero-scrim pointer-events-none absolute inset-0 z-10" aria-hidden="true"></div>

  <!-- Content: low and left, as on a printed poster; mt-auto pins the whole
       block to the section's foot so the caption lands in the real corner -->
  <div class="container hero-content relative z-20 mt-auto flex flex-col">
    <div class="hero-copy flex flex-col items-start gap-6 pt-40 pb-16 md:gap-8 md:pb-20">
      <h1
        class="hero-head grain font-display font-extrabold text-paper text-[clamp(4.5rem,11vw,9rem)] leading-[0.92]"
      >
        <span class="misreg" data-text="Bonfire">Bonfire</span>
      </h1>
      <p class="hero-lead lead max-w-md text-paper">
        Indian coal, clay tandoors and a sigree of live hardwood charcoal.
      </p>
      <div class="hero-cta flex flex-wrap items-center gap-3">
        <Button href="#reserve" variant="primary" class="hero-cta-btn">Book a table</Button>
        <Button href="#dishes" variant="outline" class="hero-cta-btn">The menu</Button>
      </div>
    </div>

    <!-- Corner caption: the one fact the plate needs -->
    <p class="hero-caption self-end pb-8 text-sm md:pb-10">Est. 2026.</p>
  </div>
</section>

<style>
  /* Poster plate: the photograph prints in both drums, blue shadows into a pink screen */
  .hero-plate {
    aspect-ratio: auto;
    min-height: 0;
  }
  .hero-plate > img {
    height: 100%;
    /* Lift the mids and blow the highlights to white: multiply over the pink
       screen leaves the paper where the light is, the ink where the fire is */
    filter: grayscale(1) contrast(0.92) brightness(1.62);
  }
  /* The head prints as a solid blue band with the word knocked out to the
     stock: paper letters on the pale drums would wash out, and the pink
     echo reads against solid ink. One of the sheet's two bands. */
  .hero-head {
    align-self: flex-start;
    background: var(--color-ink);
    padding: var(--space-sm) var(--space-lg);
  }
  /* The sentence prints as a caption strip on the plate: body text over a
     bright drum would wash out, so the strip carries it like a label */
  .hero-lead {
    color: var(--color-accent-ink);
    background: var(--color-paper);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
  }
  /* The corner date prints the same way, as the smallest strip on the sheet */
  .hero-caption {
    color: var(--color-accent-ink);
    background: var(--color-paper);
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
  }
  /* A compact dark footing so the caption and CTA sit on top of the table:
     the plate's own shadows carry the copy, the scrim only holds the base */
  .hero-scrim {
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--color-ink) 55%, transparent) 0%,
      color-mix(in oklab, var(--color-ink) 24%, transparent) 14%,
      transparent 34%
    );
  }
  /* The outlined secondary is knocked out of the drum: a paper sticker on the
     plate. :global — the button's own markup lives in Button.astro, so a
     scoped selector would carry the wrong component id and never match. */
  .hero-section :global(.btn--quiet) {
    color: var(--color-accent-ink);
    background: var(--color-paper);
    border-color: var(--color-ink);
  }
  .hero-section :global(.btn--quiet:hover) {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
  /* Entrance settling states: content visible with scripting off */
  .hero-plate > img,
  .hero-copy {
    opacity: 1;
  }
  /* The pink drum settles into its offset: off-register when parked, registered when seen */
  .misreg::after {
    transform: translate(2px, 3px);
  }
  html.js .misreg::after {
    transform: translate(-16px, -22px);
    transition: transform var(--dur-long) var(--ease-out);
  }
  html.js .hero-section.hero-seen .misreg::after {
    transform: translate(2px, 3px);
  }
  @media (max-width: 40rem) {
    /* The same settle reads wider against a smaller head: the phone offset
       keeps inside the 2px-ish fringe so it never hints at a drop shadow */
    .hero-section .misreg::after {
      transform: translate(1.5px, 2px);
    }
    html.js .hero-section .misreg::after {
      transform: translate(-16px, -22px);
      transition: transform var(--dur-long) var(--ease-out);
    }
    html.js .hero-section.hero-seen .misreg::after {
      transform: translate(1.5px, 2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .hero-section .misreg::after {
      transform: translate(2px, 3px);
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { handleNavClick } from '../utils/navigateWithTransition';

  document.addEventListener('DOMContentLoaded', () => {
    const heroSection = document.querySelector('.hero-section') as HTMLElement | null;
    const heroCopy = document.querySelector('.hero-copy') as HTMLElement | null;
    const heroPlateImage = document.querySelector('.hero-plate > img') as HTMLElement | null;
    const heroCaption = document.querySelector('.hero-caption') as HTMLElement | null;

    // Reduced motion: content stamped in place, the drums already in register
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      heroSection?.classList.add('hero-seen');
      return;
    }

    // The hero CTA buttons navigate through the page transition
    const heroCtaButtons = document.querySelectorAll('.hero-cta-btn');
    heroCtaButtons.forEach((buttonElement) =>
      buttonElement.addEventListener('click', handleNavClick),
    );

    // Entrance: one settle, chained from the loading screen, staged 60 to 100ms apart
    document.addEventListener('bonfire:hero-entrance', () => {
      if (!heroSection || !heroCopy) return;

      heroSection.classList.add('hero-seen');

      const entranceTimeline = gsap.timeline({ defaults: { ease: 'power3.out' } });
      if (heroPlateImage) {
        entranceTimeline.fromTo(heroPlateImage, { opacity: 0 }, { opacity: 1, duration: 0.5 }, 0);
      }
      entranceTimeline.from(
        heroCopy.children,
        { y: 16, opacity: 0, duration: 0.6, stagger: 0.08 },
        0.12,
      );
      if (heroCaption) {
        entranceTimeline.from(heroCaption, { opacity: 0, duration: 0.5 }, 0.4);
      }
    });
  });
</script>
