---
/**
 * The fire day, printed as a job sheet: five hairline rows in Literata
 * tabular, the two fire-drums' hours carrying the pink screen, and the
 * fire philosophy set apart in a blue-framed pull.
 */
const fireDayEvents = [
  {
    time: '08:00',
    tag: 'Spice blending',
    title: 'Whole aromatic roasting',
    description:
      'We dry-roast and hand-grind cardamom, black pepper, cloves, and star anise in small batches. No pre-made masalas are ever permitted near our kitchen.',
    isFeatured: false,
  },
  {
    time: '11:00',
    tag: 'Tandoor fires',
    title: 'Clay oven heating',
    description:
      'Our clay tandoors are fueled with premium hardwood charcoal, building an intense radiant heat bed of up to 900°F.',
    isFeatured: true,
  },
  {
    time: '14:00',
    tag: 'Marination',
    title: 'The double coating',
    description:
      'Meats are subjected to two rounds of marination: first in fresh lime and ginger-garlic, then in a rich spiced hung curd and cold-pressed mustard oil.',
    isFeatured: false,
  },
  {
    time: '18:00',
    tag: 'Sigree ignition',
    title: 'Open-air grill firing',
    description:
      'The open charcoal sigrees are brought to life, establishing a glowing bed of coal embers for skewering our signature kebabs.',
    isFeatured: true,
  },
  {
    time: '21:00',
    tag: 'Dum steaming',
    title: 'Claypot slow simmer',
    description:
      'Our signature biryanis are sealed with dough in copper handis, slow-steaming over dying coals to lock in every aromatic note.',
    isFeatured: false,
  },
];
---

<section id="about" class="about-section relative w-full bg-paper py-(--section-gap)">
  <div class="container">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Fire day rows: hairline rules on the stock, tabular hours down the left -->
      <div class="story-column lg:col-span-7">
        <h2 class="font-display text-ink">The storystream</h2>
        <ol class="story-rows mt-10 border-t border-rule">
          {
            fireDayEvents.map((fireDayEvent) => (
              <li class="story-row border-b border-rule py-6 md:py-8">
                <div class="flex flex-col gap-2 md:grid md:grid-cols-[7rem_1fr] md:items-baseline md:gap-x-8">
                  <span
                    class={`story-time num ${
                      fireDayEvent.isFeatured
                        ? 'fig-overprint font-display text-2xl font-extrabold text-ink'
                        : 'font-body text-sm font-medium text-muted'
                    }`}
                  >
                    {fireDayEvent.time}
                  </span>
                  <div>
                    <h3 class="font-display text-xl font-extrabold text-ink md:text-2xl">
                      {fireDayEvent.title}
                    </h3>
                    <span class="mt-1 block font-body text-sm font-medium text-muted">
                      {fireDayEvent.tag}
                    </span>
                    <p class="mt-3 max-w-[55ch] font-body text-sm text-ink">
                      {fireDayEvent.description}
                    </p>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- The fire philosophy: a framed pull, the quote itself carries the words -->
      <aside class="philosophy-column lg:col-span-5 lg:sticky lg:top-40">
        <figure class="philosophy-frame border-[1.5px] border-ink p-6 md:p-8">
          <figcaption class="font-body text-sm font-medium text-muted">
            The fire philosophy
          </figcaption>
          <blockquote class="font-body mt-4 text-lg text-ink italic md:text-xl">
            We do not cook with gas. We do not cook with electricity. We cook with hand-built clay
            tandoors, open charcoal sigrees, and freshly ground spices. The fire is the ancient
            heartbeat of Indian kitchen.
          </blockquote>
          <div class="overprint-bar mt-6 bg-accent" aria-hidden="true"></div>
        </figure>
      </aside>
    </div>
  </div>
</section>

<style>
  /* The two fire-drum hours print across the pink screen: a solid pink shape
     multiplied over part of the figure, the purple only where they cross */
  .fig-overprint::after {
    content: '';
    position: absolute;
    right: -0.14em;
    bottom: 0.3em;
    width: 0.62em;
    height: 0.32em;
    background: var(--color-accent);
    mix-blend-mode: multiply;
  }
  .fig-overprint {
    position: relative;
    display: inline-block;
    width: fit-content;
    justify-self: start;
    isolation: isolate;
  }
  /* The pink bar on the philosophy frame: the one fill a screen allows, flat */
  .overprint-bar {
    height: 10px;
    width: 96px;
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const aboutSection = document.querySelector('.about-section') as HTMLElement | null;

    // Reduced motion: the sheet prints already in place
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const animationContext = gsap.context(() => {
      gsap.set('.story-row, .philosophy-frame', {
        willChange: 'transform, opacity',
        force3D: true,
      });

      gsap.from('.story-row', {
        y: 24,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.story-rows',
          start: 'top 80%',
          toggleActions: 'play none none none',
          immediateRender: false,
        },
      });

      gsap.from('.philosophy-frame', {
        y: 24,
        opacity: 0,
        duration: 0.7,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.philosophy-column',
          start: 'top 82%',
          toggleActions: 'play none none none',
          immediateRender: false,
        },
      });
    }, aboutSection ?? undefined);
  });
</script>
