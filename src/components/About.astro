---
/**
 * The fire day, printed as an editorial craft sheet: five hairline rows with
 * consistent tabular hours, structured phase labels, and the fire philosophy
 * set apart in a framed pull.
 */
const fireDayEvents = [
  {
    time: '08:00',
    tag: 'Spice blending',
    title: 'Whole aromatic roasting',
    description:
      'We dry-roast and hand-grind cardamom, black pepper, cloves, and star anise in small batches. No pre-made masalas are ever permitted near our kitchen.',
    isFeatured: false,
  },
  {
    time: '11:00',
    tag: 'Tandoor fires',
    title: 'Clay oven heating',
    description:
      'Our clay tandoors are fueled with premium hardwood charcoal, building an intense radiant heat bed of up to 900°F.',
    isFeatured: true,
  },
  {
    time: '14:00',
    tag: 'Marination',
    title: 'The double coating',
    description:
      'Meats are subjected to two rounds of marination: first in fresh lime and ginger-garlic, then in a rich spiced hung curd and cold-pressed mustard oil.',
    isFeatured: false,
  },
  {
    time: '18:00',
    tag: 'Sigree ignition',
    title: 'Open-air grill firing',
    description:
      'The open charcoal sigrees are brought to life, establishing a glowing bed of coal embers for skewering our signature kebabs.',
    isFeatured: true,
  },
  {
    time: '21:00',
    tag: 'Dum steaming',
    title: 'Claypot slow simmer',
    description:
      'Our signature biryanis are sealed with dough in copper handis, slow-steaming over dying coals to lock in every aromatic note.',
    isFeatured: false,
  },
];
---

<section id="about" class="about-section relative w-full bg-paper py-(--section-gap)">
  <div class="container">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Fire day rows: hairline rules on paper, consistent tabular hours -->
      <div class="story-column lg:col-span-7">
        <h2 class="font-display text-3xl font-extrabold text-ink md:text-4xl">The storystream</h2>
        <p class="mt-2 font-body text-sm font-medium text-muted">
          A daily chronicle of coals, clay ovens, and hand-ground spices from dawn to midnight
          embers.
        </p>

        <ol class="story-rows mt-10 border-t border-rule">
          {
            fireDayEvents.map((fireDayEvent, eventIndex) => (
              <li
                class={`story-row border-b border-rule py-6 md:py-8 transition-colors ${
                  fireDayEvent.isFeatured
                    ? 'rounded-xs bg-paper-2/40 -mx-3 px-3 md:-mx-4 md:px-4'
                    : ''
                }`}
              >
                <div class="flex flex-col gap-3 md:grid md:grid-cols-[7.5rem_1fr] md:items-baseline md:gap-x-8">
                  <div class="flex items-baseline gap-3 md:flex-col md:gap-1">
                    <span class="story-time num font-display text-2xl font-extrabold text-ink tabular-nums">
                      {fireDayEvent.time}
                    </span>
                    {fireDayEvent.isFeatured ? (
                      <span class="inline-flex items-center rounded-xs border border-accent/40 bg-accent/10 px-2 py-0.5 font-body text-xs font-semibold text-accent-ink">
                        Peak heat
                      </span>
                    ) : (
                      <span class="font-body text-xs font-medium text-muted">
                        Stage {eventIndex + 1}
                      </span>
                    )}
                  </div>
                  <div>
                    <span class="block font-body text-xs font-semibold text-muted">
                      {fireDayEvent.tag}
                    </span>
                    <h3 class="mt-1 font-display text-xl font-extrabold text-ink md:text-2xl">
                      {fireDayEvent.title}
                    </h3>
                    <p class="mt-2.5 max-w-[55ch] font-body text-sm leading-relaxed text-ink/85">
                      {fireDayEvent.description}
                    </p>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- The fire philosophy: a framed pull, the quote itself carries the words -->
      <aside class="philosophy-column lg:col-span-5 lg:sticky lg:top-40">
        <figure class="philosophy-frame border-[1.5px] border-ink p-6 md:p-8 bg-paper">
          <figcaption class="font-body text-sm font-medium text-muted">
            The fire philosophy
          </figcaption>
          <blockquote class="font-body mt-4 text-lg text-ink italic leading-snug md:text-xl">
            We do not cook with gas. We do not cook with electricity. We cook with hand-built clay
            tandoors, open charcoal sigrees, and freshly ground spices. The fire is the ancient
            heartbeat of Indian kitchen.
          </blockquote>
          <div class="overprint-bar mt-6 bg-accent" aria-hidden="true"></div>
        </figure>
      </aside>
    </div>
  </div>
</section>

<style>
  /* The pink accent bar on the philosophy frame: the one fill a screen allows, flat */
  .overprint-bar {
    height: 8px;
    width: 80px;
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const aboutSectionElement = document.querySelector('.about-section') as HTMLElement | null;

    // Reduced motion: the sheet prints already in place
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const animationContext = gsap.context(() => {
      gsap.set('.story-row, .philosophy-frame', {
        willChange: 'transform, opacity',
        force3D: true,
      });

      gsap.from('.story-row', {
        y: 24,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.story-rows',
          start: 'top 80%',
          toggleActions: 'play none none none',
          immediateRender: false,
        },
      });

      gsap.from('.philosophy-frame', {
        y: 24,
        opacity: 0,
        duration: 0.7,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.philosophy-column',
          start: 'top 82%',
          toggleActions: 'play none none none',
          immediateRender: false,
        },
      });
    }, aboutSectionElement ?? undefined);
  });
</script>
