---
/**
 * The booking: the statement printed on the blue band (band two of two), the
 * form itself a stock sheet with blue-framed fields. Every control, field and
 * event of the old card is kept; only the sheet it lives on changed.
 */
import Button from './Button.astro';
import ReservationInfo from './reservation/ReservationInfo.astro';
import CalendarPicker from './reservation/CalendarPicker.astro';
import TimePicker from './reservation/TimePicker.astro';
import CustomDropdown from './reservation/CustomDropdown.astro';
import BookingToast from './reservation/BookingToast.astro';
---

<section id="reserve" class="reserve-section relative w-full bg-paper py-(--section-gap-s)">
  <div class="container">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Left column: the blue band -->
      <ReservationInfo />

      <!-- Right column: the form sheet, framed in the blue -->
      <div class="reserve-card-wrap relative lg:col-span-7">
        <div class="reserve-card flex flex-col gap-6 border-[1.5px] border-ink bg-paper p-6 md:p-8">
          <div class="flex items-baseline justify-between border-b border-rule pb-4">
            <span class="font-body text-sm font-medium text-muted">Hearth booking</span>
            <span class="font-body text-xs text-muted">Code: Pit-001</span>
          </div>

          <form class="flex flex-col gap-5" onsubmit="return false">
            <!-- Name & Email -->
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <div class="flex flex-col gap-2">
                <label for="name" class="font-body text-sm font-medium text-muted">Your name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  maxlength="100"
                  autocomplete="name"
                  placeholder="e.g. Marcus Aurelius"
                  required
                  class="reserve-field"
                />
              </div>
              <div class="flex flex-col gap-2">
                <label for="email" class="font-body text-sm font-medium text-muted"
                  >Email address</label
                >
                <input
                  type="email"
                  id="email"
                  name="email"
                  maxlength="254"
                  autocomplete="email"
                  placeholder="e.g. pit@bonfire.com"
                  required
                  class="reserve-field"
                />
              </div>
            </div>

            <!-- Date & Time -->
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <CalendarPicker />
              <TimePicker />
            </div>

            <!-- Guests & Preference -->
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <CustomDropdown
                name="guests"
                label="Hearth seating"
                placeholder="Select seating"
                options={[
                  { value: '2', label: '2 Pitmasters' },
                  { value: '4', label: '4 Pitmasters' },
                  { value: '6', label: '6 Pitmasters' },
                  { value: '8', label: '8+ (Private Table)' },
                ]}
              />
              <CustomDropdown
                name="preference"
                label="Hearth preference"
                placeholder="Select preference"
                options={[
                  { value: 'tandoor-side', label: 'Tandoor Side (Direct clay oven view)' },
                  { value: 'sigree-view', label: 'Sigree Grill View (Plated kebabs prep view)' },
                  {
                    value: 'biryani-lounge',
                    label: 'Biryani Hearth Lounge (Aromatic claypot steam)',
                  },
                  { value: 'chefs-table', label: "Chef's Table (Curated multi-course tasting)" },
                ]}
              />
            </div>

            <!-- Submit -->
            <Button
              as="button"
              type="button"
              variant="primary"
              class="reserve-submit mt-3 self-start"
            >
              Reserve hearth seating
            </Button>
          </form>

          <BookingToast />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Fields: 48px on the stock, 2px radius, the value set in Cabinet 800 */
  .reserve-field {
    height: 48px;
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-card);
    background: transparent;
    padding: 0 var(--space-md);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    color: var(--color-ink);
  }
  .reserve-field::placeholder {
    font-family: var(--font-body);
    font-weight: 400;
    color: var(--color-muted);
  }
  .reserve-field:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const abortController = new AbortController();
    const reserveSection = document.querySelector('.reserve-section') as HTMLElement | null;
    const reserveCard = document.querySelector('.reserve-card') as HTMLElement | null;

    if (!reserveSection) return;

    // Entrance: the sheet lands once, nothing loops
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const animationContext = gsap.context(() => {
        if (reserveCard) {
          gsap.from(reserveCard, {
            y: 40,
            opacity: 0,
            duration: 0.8,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: reserveSection,
              start: 'top 72%',
              toggleActions: 'play none none none',
              immediateRender: false,
            },
          });
        }
      }, reserveSection ?? undefined);
    }

    // Reserve button click → toast. The submit sheet does not send anywhere:
    // the overlay prints the honest state instead of inventing a confirmation.
    const reserveSubmitButton = reserveSection.querySelector(
      '.reserve-submit',
    ) as HTMLElement | null;

    if (reserveSubmitButton) {
      reserveSubmitButton.addEventListener(
        'click',
        (clickEvent) => {
          clickEvent.preventDefault();
          document.dispatchEvent(new CustomEvent('bonfire:show-toast'));
        },
        { signal: abortController.signal },
      );
    }
  });
</script>
