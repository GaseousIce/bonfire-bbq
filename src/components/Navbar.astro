---
import Button from './Button.astro';

const navLinks = [
  { href: '#about', label: 'Timeline' },
  { href: '#dishes', label: 'Menu' },
  { href: '#gallery', label: 'Atmosphere' },
];
const mobileOnlyLinks = [{ href: '#reserve', label: 'Book a table' }];
---

<header class="navbar-wrapper fixed top-0 left-0 z-50 w-full px-4 pt-5 md:px-8">
  <!-- Floating printed chip: a ticket pinned to the sheet -->
  <div
    class="navbar-chip grain mx-auto flex w-fit items-center gap-2 border py-2 pr-2.5 pl-4 md:gap-6"
  >
    <!-- Brand wordmark -->
    <a
      href="#hero"
      class="brand-logo font-display text-2xl leading-none font-extrabold tracking-tight select-none"
      aria-label="Bonfire, back to the top"
    >
      Bonfire
    </a>

    <span class="hidden h-5 w-px bg-rule md:block" aria-hidden="true"></span>

    <!-- Nav links (desktop) -->
    <nav class="hidden items-center gap-6 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link py-1 text-sm font-medium transition-colors duration-200 hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <span class="hidden h-5 w-px bg-rule md:block" aria-hidden="true"></span>

    <!-- Right side action: quieter than the hero's primary -->
    <div class="hidden md:block">
      <Button href="#reserve" variant="outline" class="nav-cta min-h-11 px-5!">
        Book a table
      </Button>
    </div>

    <!-- Mobile menu toggle: desktop's inline nav and CTA make the drawer
         redundant, so the trigger only exists below md -->
    <button
      class="mobile-toggle p-2 text-ink hover:text-ink-2 md:hidden"
      aria-label="Open menu"
      type="button"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile drawer: off-canvas at rest, so it is also invisible (not just
       translated) — an off-screen panel that still paints widens the phone
       page and is read by assistive tech -->
  <div
    class="mobile-drawer invisible fixed inset-y-0 right-0 z-50 flex w-72 translate-x-full flex-col gap-8 border-l bg-paper p-8 transition-transform duration-300"
    role="dialog"
    aria-label="Site menu"
  >
    <div class="flex items-center justify-between">
      <a
        href="#hero"
        class="brand-logo font-display text-2xl leading-none tracking-tight select-none"
        aria-label="Bonfire, back to the top"
      >
        Bonfire
      </a>
      <button
        class="mobile-close p-2 text-ink hover:text-ink-2"
        aria-label="Close menu"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <nav class="mt-8 flex flex-col gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link py-3 text-lg font-medium transition-colors hover:text-ink-2"
          >
            {link.label}
          </a>
        ))
      }
      {
        mobileOnlyLinks.map((link) => (
          <a href={link.href} class="mobile-nav-link underlined-link py-3 text-lg font-medium">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* The printed ticket: paper stock over the photograph, ink hairline */
  .navbar-chip {
    background: var(--color-paper);
    border-color: var(--color-ink);
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .nav-link {
    color: var(--color-muted);
    text-decoration: transparent underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .nav-link--active {
    color: var(--color-ink);
    text-decoration-color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .navbar-chip,
    .nav-link,
    .mobile-drawer {
      transition: none;
    }
  }
</style>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { handleNavClick } from '../utils/navigateWithTransition';

  document.addEventListener('DOMContentLoaded', () => {
    const brandLogoElement = document.querySelector('.brand-logo') as HTMLElement | null;
    const desktopNavLinkElements = Array.from(document.querySelectorAll<HTMLElement>('.nav-link'));
    const navCtaButtons = document.querySelectorAll('.nav-cta');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
    const mobileToggle = document.querySelector('.mobile-toggle');
    const mobileClose = document.querySelector('.mobile-close');
    const mobileDrawer = document.querySelector('.mobile-drawer');

    // Mobile drawer open/close
    let drawerHideTimer = 0;

    const setDrawerOpen = (isOpen: boolean) => {
      if (!mobileDrawer) return;
      window.clearTimeout(drawerHideTimer);
      if (isOpen) {
        mobileDrawer.classList.remove('invisible');
        requestAnimationFrame(() => mobileDrawer.classList.remove('translate-x-full'));
        return;
      }
      mobileDrawer.classList.add('translate-x-full');
      drawerHideTimer = window.setTimeout(() => {
        mobileDrawer.classList.add('invisible');
      }, 320);
    };

    mobileToggle?.addEventListener('click', () => setDrawerOpen(true));
    mobileClose?.addEventListener('click', () => setDrawerOpen(false));

    // Escape closes the drawer
    document.addEventListener('keyup', (keyboardEvent) => {
      if (keyboardEvent.key === 'Escape') setDrawerOpen(false);
    });

    // Nav link & CTA clicks via page transition
    brandLogoElement?.addEventListener('click', handleNavClick);
    desktopNavLinkElements.forEach((navLinkElement) =>
      navLinkElement.addEventListener('click', handleNavClick),
    );
    navCtaButtons.forEach((ctaButton) => ctaButton.addEventListener('click', handleNavClick));
    mobileNavLinks.forEach((mobileLink) => {
      mobileLink.addEventListener('click', (mouseEvent) => {
        handleNavClick(mouseEvent);
        setDrawerOpen(false);
      });
    });

    // Map href -> navLinkElement for O(1) active class updates
    const sectionToNavLinkMap = new Map<string, HTMLElement>();
    desktopNavLinkElements.forEach((navLink) => {
      const targetHref = navLink.getAttribute('href');
      if (targetHref) sectionToNavLinkMap.set(targetHref, navLink);
    });

    // Active state is a colour and a pink underline; nothing moves
    const setActiveNavLink = (targetNavLink: HTMLElement | null) => {
      desktopNavLinkElements.forEach((navLink) => {
        navLink.classList.toggle('nav-link--active', navLink === targetNavLink);
      });
    };

    // ScrollTrigger active link highlighting for section scroll
    const navSectionSelectorIds = ['#hero', '#about', '#dishes', '#gallery', '#reserve'];
    navSectionSelectorIds.forEach((sectionSelectorId) => {
      const sectionElement = document.querySelector(sectionSelectorId);
      if (!sectionElement) return;
      ScrollTrigger.create({
        trigger: sectionElement,
        start: sectionSelectorId === '#hero' ? 'top top' : 'top 40%',
        end: 'bottom 40%',
        onToggle: (scrollTriggerInstance) => {
          if (scrollTriggerInstance.isActive) {
            const activeNavLink = sectionToNavLinkMap.get(sectionSelectorId) || null;
            setActiveNavLink(sectionSelectorId === '#hero' ? null : activeNavLink);
          }
        },
      });
    });
  });
</script>
