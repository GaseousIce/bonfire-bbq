---
/**
 * A blue-framed value control on the stock: the trigger prints its value in
 * Cabinet 800, the option sheet is a flat panel with a 1.5px blue frame.
 */
interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  label: string;
  placeholder?: string;
  options: Option[];
  optionsClass?: string;
}

const { name, label, placeholder = 'Select', options, optionsClass = '' } = Astro.props;
---

<div class="flex flex-col gap-2">
  <label for={`${name}-trigger`} class="font-body text-sm font-medium text-muted">
    {label}
  </label>
  <div class="custom-select relative" data-name={name}>
    <input type="hidden" name={name} value="" />
    <button
      type="button"
      id={`${name}-trigger`}
      class="custom-select-trigger h-12 w-full cursor-pointer rounded-[2px] border-[1.5px] border-ink bg-paper px-4 font-display text-[15px] font-extrabold text-ink flex items-center justify-between"
      role="combobox"
      aria-expanded="false"
      aria-haspopup="listbox"
      aria-label={label}
    >
      <span class="custom-select-label text-muted">{placeholder}</span>
      <svg
        class="custom-select-arrow w-3 h-2 flex-shrink-0 text-muted"
        width="12"
        height="8"
        viewBox="0 0 12 8"
        fill="none"
        style="transform-origin: center;"
      >
        <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
        ></path>
      </svg>
    </button>
    <div
      class={`custom-select-options absolute top-full left-0 right-0 z-20 mt-1.5 overflow-hidden rounded-[2px] border-[1.5px] border-ink bg-paper {optionsClass}`}
      role="listbox"
      style="display: none; opacity: 0; transform: translateY(-6px);"
    >
      {
        options.map((optionItem) => (
          <button
            type="button"
            class="custom-select-option block w-full cursor-pointer border-b border-rule px-4 py-3 text-left font-body text-sm text-ink transition-colors duration-150 last:border-b-0 hover:bg-paper-2 md:text-[15px]"
            role="option"
            data-value={optionItem.value}
          >
            {optionItem.label}
          </button>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { initCustomDropdown } from '../../scripts/dropdown';

  document.addEventListener('DOMContentLoaded', () => {
    const abortController = new AbortController();
    document.querySelectorAll('.custom-select').forEach((dropdownContainer) => {
      initCustomDropdown(dropdownContainer as HTMLElement, abortController.signal);
    });
  });
</script>
