---
/**
 * The honest overlay: this sheet has no endpoint, so a press covers the form
 * with solid ink and prints a paper sticker — never a fabricated confirmation.
 */
---

<div
  class="reserve-toast pointer-events-none absolute inset-0 z-20 flex flex-col items-center justify-center rounded-[2px]"
  style="opacity: 0;"
  role="status"
  aria-live="polite"
  hidden
>
  <div class="absolute inset-0 rounded-[2px] bg-ink"></div>
  <div
    class="relative mx-6 flex flex-col items-center gap-3 border-[1.5px] border-ink bg-paper px-8 py-7 text-center"
  >
    <span class="inline-block h-2.5 w-2.5 bg-accent" aria-hidden="true"></span>
    <span class="font-display text-lg font-extrabold text-ink">Booking coming soon.</span>
    <span class="font-body text-sm text-ink italic">We’ll be taking reservations shortly</span>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const abortController = new AbortController();
    const toastElement = document.querySelector('.reserve-toast') as HTMLElement;
    if (!toastElement) return;

    const toastInner = toastElement.querySelector('.relative') as HTMLElement;
    if (!toastInner) return;

    let toastTween: gsap.core.Timeline | null = null;
    let autoDismiss: gsap.core.Tween | null = null;

    function showToast() {
      if (toastTween) toastTween.kill();
      if (autoDismiss) autoDismiss.kill();

      toastElement.hidden = false;
      toastElement.style.pointerEvents = 'auto';
      toastTween = gsap.timeline();
      toastTween.fromTo(
        toastElement,
        { opacity: 0 },
        { opacity: 1, duration: 0.35, ease: 'power2.out' },
        0,
      );
      toastTween.fromTo(
        toastInner,
        { opacity: 0, y: 12 },
        { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' },
        0.1,
      );

      autoDismiss = gsap.delayedCall(4, hideToast);
    }

    function hideToast() {
      if (toastTween) toastTween.kill();
      if (autoDismiss) autoDismiss.kill();

      toastTween = gsap.timeline({
        onComplete: () => {
          toastElement.style.pointerEvents = 'none';
          toastElement.hidden = true;
        },
      });
      toastTween.to(toastInner, { opacity: 0, duration: 0.2, ease: 'power2.in' }, 0);
      toastTween.to(toastElement, { opacity: 0, duration: 0.25, ease: 'power2.in' }, 0.05);
    }

    document.addEventListener('bonfire:show-toast', () => showToast(), {
      signal: abortController.signal,
    });

    toastElement.addEventListener('click', () => hideToast(), { signal: abortController.signal });
  });
</script>
