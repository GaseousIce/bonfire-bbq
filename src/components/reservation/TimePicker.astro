---
/**
 * The time control: a blue-framed trigger and a flat panel of chips, each
 * a small rectangle on the stock, the chosen one filled with the pink drum.
 */
const timeChipData = [
  {
    section: 'Lunch',
    chips: [
      { value: '11:30', label: '11:30 AM' },
      { value: '12:30', label: '12:30 PM' },
      { value: '13:30', label: '1:30 PM' },
      { value: '14:30', label: '2:30 PM' },
    ],
  },
  {
    section: 'Dinner',
    chips: [
      { value: '17:00', label: '5:00 PM' },
      { value: '18:00', label: '6:00 PM' },
      { value: '19:00', label: '7:00 PM' },
      { value: '20:00', label: '8:00 PM' },
      { value: '21:00', label: '9:00 PM' },
    ],
  },
];
---

<div class="flex flex-col gap-2">
  <label for="time-trigger" class="font-body text-sm font-medium text-muted">Time</label>
  <div class="time-picker-wrap relative">
    <input type="hidden" name="time" value="" />
    <button
      type="button"
      id="time-trigger"
      class="time-trigger h-12 w-full cursor-pointer rounded-[2px] border-[1.5px] border-ink bg-paper px-4 font-display text-[15px] font-extrabold text-ink flex items-center justify-between"
      role="combobox"
      aria-expanded="false"
      aria-label="Time"
    >
      <span class="time-label text-muted">Select time</span>
      <svg
        class="w-3.5 h-3.5 flex-shrink-0 text-muted"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
    </button>

    <!-- Time panel -->
    <div
      class="time-panel absolute top-full left-0 right-0 z-30 mt-1.5 flex min-w-[280px] flex-col gap-3 rounded-[2px] border-[1.5px] border-ink bg-paper p-4"
      style="display: none; opacity: 0; transform: translateY(-6px);"
    >
      {
        timeChipData.map((group) => (
          <div>
            <span class="mb-2 block font-body text-[11px] text-muted">{group.section}</span>
            <div class="grid grid-cols-3 gap-2">
              {group.chips.map((chip) => (
                <button
                  type="button"
                  class="time-chip num cursor-pointer rounded-[2px] border border-ink bg-paper py-2 px-1 text-center font-display text-[13px] font-extrabold text-ink transition-colors duration-150 hover:bg-paper-2"
                  data-value={chip.value}
                >
                  {chip.label}
                </button>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const abortController = new AbortController();
    const timeContainer = document.querySelector('.time-picker-wrap');
    if (!timeContainer) return;

    const timeTriggerButton = timeContainer.querySelector('.time-trigger') as HTMLElement;
    const timePanelElement = timeContainer.querySelector('.time-panel') as HTMLElement;
    const timeLabelElement = timeContainer.querySelector('.time-label') as HTMLElement;
    const timeHiddenInput = timeContainer.querySelector('input[type="hidden"]') as HTMLInputElement;
    const timeChips = timeContainer.querySelectorAll('.time-chip') as NodeListOf<HTMLElement>;

    let isTimeOpen = false;
    let lastSelectedDate: Date | null = null;

    function updateTimeChipsState(selectedDate: Date | null) {
      const now = new Date();
      const isToday =
        selectedDate !== null &&
        selectedDate.getDate() === now.getDate() &&
        selectedDate.getMonth() === now.getMonth() &&
        selectedDate.getFullYear() === now.getFullYear();
      const currentMinutes = now.getHours() * 60 + now.getMinutes();
      timeChips.forEach((chip) => {
        if (!chip.dataset.value) return;
        const [hours, minutes] = chip.dataset.value.split(':').map(Number);
        const chipMinutes = hours * 60 + minutes;
        const isPast = selectedDate === null || (isToday && chipMinutes <= currentMinutes);
        (chip as HTMLButtonElement).disabled = isPast;

        chip.classList.toggle('opacity-25', isPast);
        chip.classList.toggle('cursor-not-allowed', isPast);
        chip.classList.toggle('text-muted', isPast);
        chip.classList.toggle('border-ink', !isPast);

        if (isPast && timeHiddenInput.value === chip.dataset.value) {
          timeHiddenInput.value = '';
          timeLabelElement.textContent = 'Select time';
          timeLabelElement.classList.add('text-muted');
        }

        if (isPast) {
          chip.classList.remove(
            'bg-paper',
            'text-ink',
            'border-ink',
            'hover:bg-paper-2',
            'bg-accent',
            'text-accent-ink',
            'border-accent',
          );
        } else {
          const isSelected = timeHiddenInput.value === chip.dataset.value;
          chip.classList.add('hover:bg-paper-2');
          chip.classList.remove('text-muted');

          if (isSelected) {
            chip.classList.remove('bg-paper', 'text-ink', 'border-ink');
            chip.classList.add('bg-accent', 'text-accent-ink', 'border-accent');
          } else {
            chip.classList.remove('bg-accent', 'text-accent-ink', 'border-accent');
            chip.classList.add('bg-paper', 'text-ink', 'border-ink');
          }
        }
      });
    }

    const timePanelTween = gsap.fromTo(
      timePanelElement,
      { opacity: 0, y: -6 },
      {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: 'elastic.out(1, 0.4)',
        easeReverse: 'power2.in',
        paused: true,
        onReverseComplete: () => {
          timePanelElement.style.display = 'none';
        },
      },
    );

    function openTimePanel() {
      if (isTimeOpen) return;
      isTimeOpen = true;

      updateTimeChipsState(lastSelectedDate);

      const event = new CustomEvent('bonfire:dropdown-opened', {
        detail: { target: timeContainer },
      });
      document.dispatchEvent(event);

      timeTriggerButton.setAttribute('aria-expanded', 'true');
      timePanelElement.style.display = 'block';
      timePanelTween.restart();

      gsap.fromTo(
        timeChips,
        { opacity: 0, y: 10, scale: 0.9 },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.35,
          stagger: 0.03,
          ease: 'back.out(1.4)',
          clearProps: 'scale',
        },
      );
    }

    function closeTimePanel() {
      if (!isTimeOpen) return;
      isTimeOpen = false;
      timeTriggerButton.setAttribute('aria-expanded', 'false');
      timePanelTween.timeScale(2).reverse();
    }

    timeTriggerButton.addEventListener('click', (clickEvent) => {
      clickEvent.stopPropagation();
      isTimeOpen ? closeTimePanel() : openTimePanel();
    });

    timeChips.forEach((chip) => {
      chip.addEventListener('click', (clickEvent) => {
        if ((chip as HTMLButtonElement).disabled) return;
        clickEvent.stopPropagation();
        const value = chip.dataset.value;
        const text = chip.textContent;

        timeChips.forEach((chipElement) => {
          chipElement.classList.remove('bg-accent', 'text-accent-ink', 'border-accent');
          chipElement.classList.add('bg-paper', 'text-ink', 'border-ink');
        });

        chip.classList.remove('bg-paper', 'text-ink', 'border-ink');
        chip.classList.add('bg-accent', 'text-accent-ink', 'border-accent');

        if (timeLabelElement && text) {
          timeLabelElement.textContent = text;
          timeLabelElement.classList.remove('text-muted');
        }
        if (timeHiddenInput && value) {
          timeHiddenInput.value = value;
        }

        closeTimePanel();
      });
    });

    document.addEventListener(
      'click',
      (clickEvent) => {
        if (!timeContainer.contains(clickEvent.target as Node) && isTimeOpen) {
          closeTimePanel();
        }
      },
      { signal: abortController.signal },
    );

    document.addEventListener(
      'bonfire:dropdown-opened',
      ((customEvent: CustomEvent) => {
        if (isTimeOpen && !timeContainer.contains(customEvent.detail.target as Node)) {
          closeTimePanel();
        }
      }) as EventListener,
      { signal: abortController.signal },
    );

    document.addEventListener(
      'bonfire:date-selected',
      ((event: CustomEvent) => {
        lastSelectedDate = event.detail.date;
        updateTimeChipsState(event.detail.date);
        setTimeout(() => {
          openTimePanel();
        }, 150);
      }) as EventListener,
      { signal: abortController.signal },
    );
  });
</script>
