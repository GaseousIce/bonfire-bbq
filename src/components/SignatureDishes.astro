---
/**
 * The menu as a price list on the light pink screen: blue hairline rows in
 * Literata tabular figures, a live total in the display face carrying the
 * pink screen. The old pinned horizontal card deck is gone by design.
 */
const menuRows = [
  {
    tag: 'Dum pukht',
    title: 'Chicken dum biryani',
    description:
      'Fragrant basmati rice layered with juicy, spiced marinated chicken, fresh mint, coriander, and saffron, slow-steamed in a dough-sealed clay handi.',
    price: '₹450',
    isFeatured: false,
  },
  {
    tag: 'Clay tandoor',
    title: 'Whole tandoori chicken',
    description:
      'A whole spring chicken marinated in Kashmiri red chilies, freshly crushed garlic, and hand-churned yogurt, roasted on long iron skewers in our clay oven.',
    price: '₹550',
    isFeatured: false,
  },
  {
    tag: 'Heritage recipe',
    title: 'Classic handi biryani',
    description:
      'Slow-simmered basmati rice layered with tender baby lamb, caramelized onions, kewra water, and spices, cooked under a flour lid seal over dying embers.',
    price: '₹480',
    isFeatured: false,
  },
  {
    tag: 'Sigree charcoal',
    title: 'Chicken junglee kebab',
    description:
      'Spicy, rustic chicken thighs roasted on skewers over an open iron sigree, coated in green chili paste, chopped cilantro, and dry-roasted peppercorns.',
    price: '₹380',
    isFeatured: false,
  },
  {
    tag: 'Steamed & crisped',
    title: 'Crispy fried momos',
    description:
      'Hand-folded dumplings stuffed with spiced minced chicken, scallions, and fresh ginger, flash-fried to golden perfection and served with a roasted tomato chutney.',
    price: '₹220',
    isFeatured: false,
  },
  {
    tag: 'East-west fusion',
    title: 'Stuffed mozzarella chicken',
    description:
      'Tender chicken breast stuffed with fresh mozzarella, coriander pesto, and mild Indian spices, cooked over gentle pecan wood embers.',
    price: '₹490',
    isFeatured: false,
  },
  {
    tag: 'Spit roasted',
    title: 'Hearth-roasted shawarma',
    description:
      'Shaved slow-roasted chicken thighs marinated in yogurt, garlic, lemon, and spices, wrapped in fresh flatbread with garlic toum.',
    price: '₹280',
    isFeatured: false,
  },
  {
    tag: 'Creamy hearth',
    title: 'Cardamom malai kebab',
    description:
      'Bites of boneless chicken marinated in white pepper, cream cheese, green coriander roots, and green cardamom, grilled over ash-tempered embers.',
    price: '₹390',
    isFeatured: false,
  },
  {
    tag: 'The hearth board',
    title: 'Tandoori mini platter',
    description:
      'A curated tasting assortment featuring malai kebab, chicken tikka, junglee kebab, and grilled paneer, served with house-made mint-coriander chutney.',
    price: '₹750',
    isFeatured: true,
  },
];
---

<section id="dishes" class="dishes-section relative w-full bg-paper">
  <div class="pt-(--section-gap)">
    <div class="container">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <h2 class="font-display text-ink">Signature dishes</h2>
        <p class="max-w-sm font-body text-sm text-muted">
          Our culinary story is written in charcoal, clay, and spice. Browse the menu below, where
          each row is a chapter of woodfire and clay-oven craft.
        </p>
      </div>
    </div>
  </div>

  <!-- The price list rides the light pink screen, edge to edge -->
  <div class="menu-sheet mt-16 bg-paper-2 py-14 md:py-20">
    <div class="container">
      <ul class="price-rows border-t border-[color-mix(in_oklab,var(--color-ink)_14%,transparent)]">
        {
          menuRows.map((menuRow) => (
            <li
              class={`menu-row border-b border-[color-mix(in_oklab,var(--color-ink)_14%,transparent)] py-5 md:py-6 ${
                menuRow.isFeatured
                  ? 'featured-row bg-paper border-[1.5px]! border-ink! px-4 -mx-4 md:px-6 md:-mx-6 my-8 shadow-none'
                  : ''
              }`}
            >
              <div class="grid grid-cols-[1fr_auto] items-baseline gap-x-4 md:grid-cols-[1.1fr_1.6fr_auto] md:gap-x-8">
                <div>
                  <h3 class="font-display text-lg font-extrabold text-ink md:text-xl">
                    {menuRow.title}
                  </h3>
                  <span class="mt-1 block font-body text-sm text-muted">{menuRow.tag}</span>
                </div>
                <p class="menu-description hidden font-body text-sm text-ink md:block">
                  {menuRow.description}
                </p>
                <span class="menu-price num justify-self-end font-display text-2xl font-extrabold text-ink">
                  {menuRow.price}
                </span>
                <p class="menu-description--mobile col-span-2 font-body text-sm text-ink md:hidden">
                  {menuRow.description}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <!-- The live total: one figure in the display face, carrying the pink screen -->
      <div
        class="menu-total mt-12 flex items-baseline justify-between gap-6 border-[1.5px] border-ink px-6 py-6"
      >
        <span class="font-body text-sm font-medium text-muted">The board, all nine.</span>
        <span
          class="total-figure fig-overprint num font-display text-3xl font-extrabold text-ink md:text-4xl"
        >
          ₹3,990
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* The total figure prints across the pink screen: the purple only where
     the two drums cross */
  .fig-overprint::after {
    content: '';
    position: absolute;
    right: -0.14em;
    bottom: 0.3em;
    width: 0.62em;
    height: 0.32em;
    background: var(--color-accent);
    mix-blend-mode: multiply;
  }
  .fig-overprint {
    position: relative;
    display: inline-block;
    isolation: isolate;
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const dishesSection = document.querySelector('.dishes-section') as HTMLElement | null;

    // Reduced motion: the price list prints already in place
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const animationContext = gsap.context(() => {
      gsap.set('.menu-row', { willChange: 'transform, opacity', force3D: true });

      gsap.from('.menu-row', {
        y: 20,
        opacity: 0,
        duration: 0.55,
        stagger: 0.06,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.price-rows',
          start: 'top 82%',
          toggleActions: 'play none none none',
          immediateRender: false,
        },
      });

      gsap.from('.menu-total', {
        opacity: 0,
        y: 16,
        duration: 0.6,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.menu-total',
          start: 'top 88%',
          toggleActions: 'play none none none',
          immediateRender: false,
        },
      });
    }, dishesSection ?? undefined);
  });
</script>
