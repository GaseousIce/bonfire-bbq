---
/**
 * The hearth showcase: the page's photographic pulls. One full-bleed tandoor
 * plate, a sigree and spices pair, one wide handi pull; every frame prints in
 * both drums through the slot duotone, captions set beneath in Literata.
 */
import { Image } from 'astro:assets';
import { galleryBiryani, gallerySigree, gallerySpices, galleryTandoor } from '../assets/images';

const hearthFrames = {
  tandoor: {
    image: galleryTandoor,
    caption: 'The tandoor: a 900°F clay oven, skewers roasting in the heat bed.',
    alt: 'Skewers of chicken roasting inside a glowing clay tandoor oven',
  },
  sigree: {
    image: gallerySigree,
    caption: 'The sigree: coal-fired kebabs over open flame.',
    alt: 'Spicy chicken kebabs cooking over an open-air charcoal sigree grill',
  },
  spices: {
    image: gallerySpices,
    caption: 'The masala: stone-ground spices, whole and crushed.',
    alt: 'Aromatic whole Indian spices being crushed on a stone mortar',
  },
  biryani: {
    image: galleryBiryani,
    caption: 'The dum handi: biryani slow-steamed over dying embers.',
    alt: 'Dough-sealed clay handi pot cooking biryani over dying embers',
  },
};
---

<section id="gallery" class="gallery-section relative w-full bg-paper py-(--section-gap)">
  <div class="container">
    <h2 class="font-display text-ink">The soul of the hearth</h2>
  </div>

  <!-- Full-bleed tandoor plate: the loudest photographic pull of the page -->
  <figure
    class="grain mt-12 h-[min(72vh,640px)]"
    data-slot="gallery-tandoor"
    data-alt={hearthFrames.tandoor.alt}
  >
    <Image
      src={hearthFrames.tandoor.image}
      alt={hearthFrames.tandoor.alt}
      class="hearth-full"
      loading="lazy"
      decoding="async"
      widths={[960, 1440, 1920]}
      sizes="100vw"
      format="webp"
      quality={80}
    />
  </figure>
  <div class="container">
    <figcaption class="mt-3 max-w-[60ch] font-body text-sm text-muted">
      {hearthFrames.tandoor.caption}
    </figcaption>
  </div>

  <!-- Pair: sigree and masala, two frames at one rhythm -->
  <div class="container frame-pair mt-(--space-2xl)">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-8">
      <div class="pair-frame">
        <figure
          class="grain aspect-[4/5]"
          data-slot="gallery-sigree"
          data-alt={hearthFrames.sigree.alt}
        >
          <Image
            src={hearthFrames.sigree.image}
            alt={hearthFrames.sigree.alt}
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            widths={[480, 720, 960]}
            sizes="(min-width: 640px) 46vw, 100vw"
            format="webp"
            quality={80}
          />
        </figure>
        <figcaption class="mt-3 font-body text-sm text-muted">
          {hearthFrames.sigree.caption}
        </figcaption>
      </div>
      <div class="pair-frame">
        <figure
          class="grain aspect-[4/5]"
          data-slot="gallery-spices"
          data-alt={hearthFrames.spices.alt}
        >
          <Image
            src={hearthFrames.spices.image}
            alt={hearthFrames.spices.alt}
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            widths={[480, 720, 960]}
            sizes="(min-width: 640px) 46vw, 100vw"
            format="webp"
            quality={80}
          />
        </figure>
        <figcaption class="mt-3 font-body text-sm text-muted">
          {hearthFrames.spices.caption}
        </figcaption>
      </div>
    </div>
  </div>

  <!-- Wide handi pull closes the run -->
  <div class="container frame-wide mt-(--space-2xl)">
    <figure
      class="grain aspect-[21/10]"
      data-slot="gallery-biryani"
      data-alt={hearthFrames.biryani.alt}
    >
      <Image
        src={hearthFrames.biryani.image}
        alt={hearthFrames.biryani.alt}
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
        widths={[960, 1440, 1920]}
        sizes="(min-width: 768px) 92vw, 100vw"
        format="webp"
        quality={80}
      />
    </figure>
    <figcaption class="mt-3 max-w-[60ch] font-body text-sm text-muted">
      {hearthFrames.biryani.caption}
    </figcaption>
  </div>
</section>

<style>
  /* The full-bleed plate holds the viewport's band between pulls */
  .hearth-full {
    height: min(72vh, 640px);
    width: 100%;
    object-fit: cover;
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const gallerySection = document.querySelector('.gallery-section') as HTMLElement | null;

    // Reduced motion: the frames print already in place
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const animationContext = gsap.context(() => {
      gsap.from('[data-slot="gallery-tandoor"]', {
        opacity: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '.gallery-section',
          start: 'top 70%',
          toggleActions: 'play none none none',
          immediateRender: false,
        },
      });

      gsap.from('.frame-pair [data-slot], .frame-wide [data-slot]', {
        y: 32,
        opacity: 0,
        duration: 0.7,
        stagger: 0.12,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.frame-pair',
          start: 'top 70%',
          toggleActions: 'play none none none',
          immediateRender: false,
        },
      });
    }, gallerySection ?? undefined);
  });
</script>
