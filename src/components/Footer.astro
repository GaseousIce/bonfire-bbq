---
/**
 * The colophon: the sheet's imprint. Navigation, the hearth's address and
 * hours, the small print naming the inks, and the legal triggers in the
 * footer's one fill.
 */
import LegalModal from './LegalModal.astro';

const currentYear = new Date().getFullYear();
---

<footer
  class="footer relative z-10 w-full overflow-hidden border-t-[1.5px] border-ink bg-paper pt-16 pb-10"
>
  <div class="container flex flex-col gap-14">
    <!-- Masthead row -->
    <div
      class="flex flex-col justify-between gap-6 border-b border-rule pb-10 md:flex-row md:items-end"
    >
      <div class="flex flex-col gap-4">
        <span
          class="brand-logo font-display text-3xl leading-none font-extrabold text-ink select-none"
        >
          Bonfire
        </span>
        <p class="max-w-sm font-body text-sm text-ink italic">
          Indian coal, clay ovens, and raw cooking mastery. Crafting premium tandoori, kebabs, and
          slow-steamed biryanis daily in the heart of the city.
        </p>
      </div>
    </div>

    <!-- Colophon columns -->
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <span class="font-body text-sm font-medium text-muted">Navigation</span>
        <ul class="mt-4 flex flex-col gap-2">
          <li>
            <a href="#hero" class="footer-nav-link underlined-link font-body text-sm text-ink"
              >Top</a
            >
          </li>
          <li>
            <a href="#about" class="footer-nav-link underlined-link font-body text-sm text-ink"
              >Timeline</a
            >
          </li>
          <li>
            <a href="#dishes" class="footer-nav-link underlined-link font-body text-sm text-ink"
              >Menu</a
            >
          </li>
          <li>
            <a href="#gallery" class="footer-nav-link underlined-link font-body text-sm text-ink"
              >Atmosphere</a
            >
          </li>
          <li>
            <a href="#reserve" class="footer-nav-link underlined-link font-body text-sm text-ink"
              >Reservations</a
            >
          </li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <span class="font-body text-sm font-medium text-muted">The hearth</span>
        <address class="mt-4 flex flex-col gap-2 font-body text-sm text-ink not-italic">
          <p>Police Line Square, OT Rd</p>
          <p>Balasore, Isamnagar, Odisha 756001, India</p>
          <p>Phone: +91 99990 39220</p>
          <p>
            Email:
            <a href="mailto:hello@bonfire-bbq.com" class="underlined-link">hello@bonfire-bbq.com</a>
          </p>
        </address>
      </div>

      <div class="md:col-span-4">
        <span class="font-body text-sm font-medium text-muted">Service hours</span>
        <div class="mt-4 flex flex-col gap-2 font-body text-sm text-ink">
          <p>Wed to Sun, 4pm to late</p>
          <p>Mon and Tue: pit closed</p>
        </div>
      </div>
    </div>

    <!-- Imprint: the sheet names its own inks -->
    <p class="max-w-[70ch] border-t border-rule pt-8 font-body text-xs text-muted">
      Set in Cabinet Grotesk and Literata. Printed in two drums, ink blue and fluorescent pink, on
      bright uncoated stock. Bonfire barbecue, {currentYear}.
    </p>

    <!-- Bottom bar -->
    <div
      class="flex flex-col items-start justify-between gap-4 border-t border-rule pt-8 sm:flex-row sm:items-center"
    >
      <span class="font-body text-xs text-muted">
        &copy; {currentYear} Bonfire barbecue. All hearths reserved.
      </span>
      <div class="flex gap-6">
        <button
          type="button"
          data-modal="privacy"
          class="legal-modal-trigger underlined-link inline-flex min-h-11 cursor-pointer items-center font-body text-xs text-ink"
          >Privacy policy</button
        >
        <button
          type="button"
          data-modal="terms"
          class="legal-modal-trigger underlined-link inline-flex min-h-11 cursor-pointer items-center font-body text-xs text-ink"
          >Terms of service</button
        >
      </div>
    </div>
  </div>
</footer>

<LegalModal />

<script>
  import { handleNavClick } from '../utils/navigateWithTransition';

  document.addEventListener('DOMContentLoaded', () => {
    const navLinks = document.querySelectorAll('.footer-nav-link');
    navLinks.forEach((linkElement) => linkElement.addEventListener('click', handleNavClick));
  });
</script>
