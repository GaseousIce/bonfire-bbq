---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import SignatureDishes from '../components/SignatureDishes.astro';
import Gallery from '../components/Gallery.astro';
import Reservation from '../components/Reservation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Bonfire Barbecue | Indian Coal & Clay Oven | Tandoor & Grill Craft">
  <!-- Main scroll sections -->
  <main class="relative z-20">
    <!-- Poster hero: the duotone tandoor plate, the word a hair out of register -->
    <Hero />

    <!-- The fire day: hairline rows on the stock -->
    <About />

    <!-- The price list: pale pink screen, tabular figures, the live total -->
    <SignatureDishes />

    <!-- The hearth showcase: four duotone pulls with captions beneath -->
    <Gallery />

    <!-- The booking: blue band, stock form sheet -->
    <Reservation />
  </main>

  <!-- The colophon -->
  <Footer />
</Layout>
